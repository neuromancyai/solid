{
  "name": "@neuromancy/solid",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "npm run build && tsc --noEmit -p tsconfig.package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "vite-node --config vitest.config.ts examples/headless.ts"
  },
  "description": "Solid: typed actors, explicit messages, and independent FIFO mailboxes.",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
