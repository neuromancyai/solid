{
  "name": "@neuromancy/solid",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actor": {
      "types": "./dist/actor/index.d.ts",
      "import": "./dist/actor/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "description": "A small actor reducer and driver with extensible commands.",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
